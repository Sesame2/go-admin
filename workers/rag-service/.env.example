# 应用配置
APP_NAME=Go Admin RAG Service
APP_VERSION=0.1.0
DEBUG=True

# 数据库配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=go_admin

# MinIO 配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=123456789
MINIO_SECURE=false
MINIO_BUCKET=documents
MINIO_REGION=us-east-1

# RabbitMQ 配置
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=123456789
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=go_admin_exchange
RABBITMQ_QUEUE=document_parse_queue
RABBITMQ_ROUTING_KEY=document.parse

# 临时文件配置
TEMP_DIR=/tmp/rag-service

# 向量数据库配置
VECTOR_DIMENSION=1024

# 通义千问配置
QWEN_API_KEY=your_qwen_api_key_here
QWEN_LLM_MODEL=qwen-max
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_EMBEDDING_DIMENSIONS=1024

# 文档分块配置
CHUNK_SIZE=12
CHUNK_OVERLAP=4
MAX_ATOM_QUESTIONS=10

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
